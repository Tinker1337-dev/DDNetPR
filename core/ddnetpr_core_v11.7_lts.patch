+void CGameContext::SaveAutoLoginSessions()
+{
+	FILE *pFile = fopen("/root/server_run/autologin_sessions.txt", "w");
+	if(!pFile)
+		return;
+	int64_t Now = time_timestamp();
+	for(const auto &S : m_vAutoLoginSessions)
+	{
+		if(S.m_ExpireTime > Now)
+			fprintf(pFile, "%s|%s|%s|%lld\n", S.m_Username.c_str(), S.m_Ip.c_str(), S.m_TimeoutCode.c_str(), (long long)S.m_ExpireTime);
+	}
+	fclose(pFile);
+}
+
+void CGameContext::LoadAutoLoginSessions()
+{
+	m_vAutoLoginSessions.clear();
+	FILE *pFile = fopen("/root/server_run/autologin_sessions.txt", "r");
+	if(!pFile)
+		return;
+	char aLine[512];
+	int64_t Now = time_timestamp();
+	while(fgets(aLine, sizeof(aLine), pFile))
+	{
+		char *p1 = strchr(aLine, '|');
+		if(!p1) continue;
+		*p1 = 0;
+		char *p2 = strchr(p1 + 1, '|');
+		if(!p2) continue;
+		*p2 = 0;
+		char *p3 = strchr(p2 + 1, '|');
+		if(!p3) continue;
+		*p3 = 0;
+		int64_t Exp = atoll(p3 + 1);
+		if(Exp > Now)
+			m_vAutoLoginSessions.push_back({aLine, p1 + 1, p2 + 1, Exp});
+	}
+	fclose(pFile);
+	log_info("autologin", "Loaded %d sessions from disk", (int)m_vAutoLoginSessions.size());
+}
