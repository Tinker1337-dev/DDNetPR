+void CGameContext::ConSetTile(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int X = pResult->GetInteger(0);
+	int Y = pResult->GetInteger(1);
+	int Tile = pResult->GetInteger(2);
+	int W = pSelf->Collision()->GetWidth();
+	int H = pSelf->Collision()->GetHeight();
+	if(X < 0 || Y < 0 || X >= W || Y >= H) return;
+	s_PluginOrigTiles.try_emplace({X, Y}, pSelf->Collision()->GetTileIndex(Y * W + X));
+	pSelf->Collision()->SetCollisionAt(X * 32.0f + 16.0f, Y * 32.0f + 16.0f, Tile);
+}
+
+void CGameContext::ConFillTiles(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int X1 = std::min(pResult->GetInteger(0), pResult->GetInteger(2));
+	int Y1 = std::min(pResult->GetInteger(1), pResult->GetInteger(3));
+	int X2 = std::max(pResult->GetInteger(0), pResult->GetInteger(2));
+	int Y2 = std::max(pResult->GetInteger(1), pResult->GetInteger(3));
+	int Tile = pResult->GetInteger(4);
+	int W = pSelf->Collision()->GetWidth();
+	int H = pSelf->Collision()->GetHeight();
+	if(X1 < 0 || Y1 < 0 || X2 >= W || Y2 >= H) return;
+	for(int y = Y1; y <= Y2; ++y)
+		for(int x = X1; x <= X2; ++x)
+		{
+			s_PluginOrigTiles.try_emplace({x, y}, pSelf->Collision()->GetTileIndex(y * W + x));
+			pSelf->Collision()->SetCollisionAt(x * 32.0f + 16.0f, y * 32.0f + 16.0f, Tile);
+		}
+}
+
+void CGameContext::ConRestoreTiles(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	for(const auto &[Coord, Orig] : s_PluginOrigTiles)
+		pSelf->Collision()->SetCollisionAt(Coord.first * 32.0f + 16.0f, Coord.second * 32.0f + 16.0f, Orig);
+	s_PluginOrigTiles.clear();
+}
