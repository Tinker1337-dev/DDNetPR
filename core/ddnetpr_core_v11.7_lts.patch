+void CGameContext::ConSpawnVisualText(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int Id = pResult->GetInteger(0);
+	if(Id < 0 || Id >= 32) return;
+	pSelf->m_aVisTexts[Id].Active = false;
+	for(int i = 0; i < pSelf->m_aVisTexts[Id].NumSegs; ++i)
+	{
+		if(pSelf->m_aVisTexts[Id].aSegs[i].SnapId >= 0)
+		{
+			pSelf->Server()->SnapFreeId(pSelf->m_aVisTexts[Id].aSegs[i].SnapId);
+			pSelf->m_aVisTexts[Id].aSegs[i].SnapId = -1;
+		}
+	}
+	pSelf->m_aVisTexts[Id].NumSegs = 0;
+	float X = pResult->GetFloat(1);
+	float Y = pResult->GetFloat(2);
+	float Scale = std::clamp(pResult->GetFloat(3), 0.25f, 8.0f);
+	int Type = pResult->GetInteger(4);
+	const char *pText = pResult->GetString(5);
+	int Len = 0;
+	while(pText[Len] && Len < 24) ++Len;
+	float W = 16.0f * Scale;
+	float H = 32.0f * Scale;
+	float Adv = 26.0f * Scale;
+	float StartX = X - (Len > 0 ? ((Len - 1) * Adv + W) * 0.5f : 0.0f);
+	int Seg = 0;
+	for(int i = 0; i < Len && Seg < 96; ++i)
+	{
+		const char *pG = GetGlyphStrokes(pText[i]);
+		float Ox = StartX + i * Adv;
+		while(*pG && Seg < 96)
+		{
+			int A = 0, B = 0;
+			while(*pG >= 48 && *pG <= 57) { A = A * 10 + (*pG - 48); ++pG; }
+			if(*pG == 44) ++pG;
+			while(*pG >= 48 && *pG <= 57) { B = B * 10 + (*pG - 48); ++pG; }
+			if(*pG == 45) ++pG;
+			vec2 P1(Ox + (A % 3) * (W * 0.5f), Y + (A / 3) * (H * 0.25f));
+			vec2 P2(Ox + (B % 3) * (W * 0.5f), Y + (B / 3) * (H * 0.25f));
+			pSelf->m_aVisTexts[Id].aSegs[Seg].From = P1;
+			pSelf->m_aVisTexts[Id].aSegs[Seg].To = P2;
+			pSelf->m_aVisTexts[Id].aSegs[Seg].SnapId = pSelf->Server()->SnapNewId().value_or(-1);
+			++Seg;
+		}
+	}
+	pSelf->m_aVisTexts[Id].Type = Type;
+	pSelf->m_aVisTexts[Id].NumSegs = Seg;
+	pSelf->m_aVisTexts[Id].Active = Seg > 0;
+}
