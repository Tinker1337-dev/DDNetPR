+	case 69: return "2,0-0,12-12,14-6,7";
+	case 70: return "2,0-0,12-6,7";
+	case 71: return "2,1-1,3-3,9-9,13-13,14-14,8-8,7";
+	case 72: return "0,12-2,14-6,8";
+	case 73: return "0,2-1,13-12,14";
+	case 74: return "2,11-11,13-13,9";
+	case 75: return "0,12-2,6-6,14";
+	case 76: return "0,12-12,14";
+	case 77: return "12,0-0,7-7,2-2,14";
+	case 78: return "12,0-0,14-14,2";
+	case 79: return "1,3-3,9-9,13-13,11-11,5-5,1";
+	case 80: return "12,0-0,1-1,5-5,7-7,6";
+	case 81: return "1,3-3,9-9,13-13,11-11,5-5,1-10,14";
+	case 82: return "12,0-0,1-1,5-5,7-7,6-7,14";
+	case 83: return "2,1-1,3-3,7-7,11-11,13-13,12";
+	case 84: return "0,2-1,13";
+	case 85: return "0,9-9,13-13,11-11,2";
+	case 86: return "0,9-9,13-13,11-11,2";
+	case 87: return "0,12-12,7-7,14-14,2";
+	case 88: return "0,14-2,12";
+	case 89: return "0,7-2,7-7,13";
+	case 90: return "0,2-2,12-12,14";
+	case 48: return "1,3-3,9-9,13-13,11-11,5-5,1-9,5";
+	case 49: return "3,1-1,13-12,14";
+	case 50: return "3,1-1,5-5,12-12,14";
