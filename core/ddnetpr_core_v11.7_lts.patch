+void CGameContext::ConRaycast(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int ReqId = pResult->GetInteger(0);
+	vec2 From(pResult->GetFloat(1), pResult->GetFloat(2));
+	vec2 To(pResult->GetFloat(3), pResult->GetFloat(4));
+	int Mask = pResult->GetInteger(5);
+	float BestDist = length(To - From) + 1.0f;
+	bool HasHit = false;
+	int HitTile = 0;
+	int HitCid = -1;
+	vec2 HitPos = To;
+
+	if((Mask & 1) != 0)
+	{
+		vec2 ColPos, BeforePos;
+		int Tile = pSelf->Collision()->IntersectLine(From, To, &ColPos, &BeforePos);
+		if(Tile != 0)
+		{
+			float d = length(ColPos - From);
+			if(d < BestDist) { BestDist = d; HasHit = true; HitTile = Tile; HitCid = -1; HitPos = ColPos; }
+		}
+	}
+	if((Mask & 2) != 0)
+	{
+		vec2 Dir = To - From;
+		float Len = length(Dir);
+		if(Len > 0.001f)
+		{
+			vec2 Norm = Dir / Len;
+			for(int i = 0; i < MAX_CLIENTS; ++i)
+			{
+				CCharacter *pChr = pSelf->GetPlayerChar(i);
+				if(!pChr) continue;
+				vec2 Rel = pChr->m_Pos - From;
+				float Proj = dot(Rel, Norm);
+				if(Proj < 0.0f || Proj > Len) continue;
+				vec2 Closest = From + Norm * Proj;
+				if(length(pChr->m_Pos - Closest) <= 28.0f && Proj < BestDist)
+				{
+					BestDist = Proj; HasHit = true; HitTile = 0; HitCid = i; HitPos = Closest;
+				}
+			}
+		}
+	}
+	log_info("ray_hit", "%d:%d:%d:%d:%.1f:%.1f:%.1f", ReqId, HasHit ? 1 : 0, HitTile, HitCid, HitPos.x, HitPos.y, HasHit ? BestDist : 0.0f);
+}
+
+void CGameContext::ConSetTile(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int X = pResult->GetInteger(0);
+	int Y = pResult->GetInteger(1);
+	int Tile = pResult->GetInteger(2);
+	int W = pSelf->Collision()->GetWidth();
+	int H = pSelf->Collision()->GetHeight();
+	if(X < 0 || Y < 0 || X >= W || Y >= H) return;
+	s_PluginOrigTiles.try_emplace({X, Y}, pSelf->Collision()->GetTileIndex(Y * W + X));
+	pSelf->Collision()->SetCollisionAt(X * 32.0f + 16.0f, Y * 32.0f + 16.0f, Tile);
+}
+
+void CGameContext::ConFillTiles(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int X1 = std::min(pResult->GetInteger(0), pResult->GetInteger(2));
+	int Y1 = std::min(pResult->GetInteger(1), pResult->GetInteger(3));
+	int X2 = std::max(pResult->GetInteger(0), pResult->GetInteger(2));
+	int Y2 = std::max(pResult->GetInteger(1), pResult->GetInteger(3));
+	int Tile = pResult->GetInteger(4);
+	int W = pSelf->Collision()->GetWidth();
+	int H = pSelf->Collision()->GetHeight();
+	if(X1 < 0 || Y1 < 0 || X2 >= W || Y2 >= H) return;
+	for(int y = Y1; y <= Y2; ++y)
+		for(int x = X1; x <= X2; ++x)
+		{
+			s_PluginOrigTiles.try_emplace({x, y}, pSelf->Collision()->GetTileIndex(y * W + x));
+			pSelf->Collision()->SetCollisionAt(x * 32.0f + 16.0f, y * 32.0f + 16.0f, Tile);
+		}
+}
+
+void CGameContext::ConRestoreTiles(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	for(const auto &[Coord, Orig] : s_PluginOrigTiles)
+		pSelf->Collision()->SetCollisionAt(Coord.first * 32.0f + 16.0f, Coord.second * 32.0f + 16.0f, Orig);
+	s_PluginOrigTiles.clear();
+}
