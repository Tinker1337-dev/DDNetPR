+void CGameContext::ConModCheck(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int ClientId = pResult->GetInteger(0);
+	if(ClientId < 0 || ClientId >= MAX_CLIENTS)
+		return;
+	bool Active = pResult->GetInteger(1) != 0;
+	if(Active)
+		str_copy(pSelf->m_aModCheckMsg[ClientId], pResult->GetString(2));
+	else
+	{
+		pSelf->m_aModCheckMsg[ClientId][0] = 0;
+		if(CCharacter *pChr = pSelf->GetPlayerChar(ClientId))
+		{
+			pChr->SetDeepFrozen(false);
+			pChr->SetSolo(false);
+			pChr->SetCollisionDisabled(false);
+			pChr->SetHookHitDisabled(false);
+		}
+		pSelf->SendBroadcast("", ClientId);
+	}
