+	int Cid = pResult->GetInteger(0);
+	int Amt = pResult->GetInteger(1);
+	if(Amt <= 0) return;
+	if(CCharacter *pChr = pSelf->GetPlayerChar(Cid))
+	{
+		int NewHp = std::min(10, pChr->GetHealth() + Amt);
+		int Rem = std::max(0, (pChr->GetHealth() + Amt) - 10);
+		int NewArm = std::min(10, pChr->GetArmor() + Rem);
+		pChr->SetHealthArmor(NewHp, NewArm);
+	}
+}
