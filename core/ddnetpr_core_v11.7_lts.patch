+
+void CGameContext::ConBcPacket(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int Cid = pResult->GetInteger(0);
+	const char *pKind = pResult->GetString(1);
+	const char *pPayload = pResult->GetString(2);
+	if(Cid < 0 || Cid >= MAX_CLIENTS || !pSelf->m_apPlayers[Cid])
+		return;
+	CMsgPacker Msg(100, true);
+	Msg.AddString(pKind);
+	Msg.AddString(pPayload);
+	pSelf->Server()->SendMsg(&Msg, MSGFLAG_FLUSH, Cid);
+}
+
+void CGameContext::ConBcSetTile(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int x = pResult->GetInteger(0);
+	int y = pResult->GetInteger(1);
+	int Index = pResult->GetInteger(2);
+	if(x >= 0 && y >= 0 && x < pSelf->Collision()->GetWidth() && y < pSelf->Collision()->GetHeight())
+	{
+		int Idx = y * pSelf->Collision()->GetWidth() + x;
+		CTile *pGame = const_cast<CTile *>(pSelf->Collision()->GameLayer());
+		pGame[Idx].m_Index = Index;
+		pGame[Idx].m_Flags = 0;
+		if(Index == 0 && pSelf->Collision()->FrontLayer())
+		{
+			CTile *pFront = const_cast<CTile *>(pSelf->Collision()->FrontLayer());
+			pFront[Idx].m_Index = 0;
+			pFront[Idx].m_Flags = 0;
+		}
+	}
+	char aPayload[64];
+	str_format(aPayload, sizeof(aPayload), "%d:%d:%d", x, y, Index);
+	for(int i = 0; i < MAX_CLIENTS; i++)
+	{
+		if(pSelf->m_apPlayers[i])
+		{
+			CMsgPacker Msg(100, true);
+			Msg.AddString("set_tile");
+			Msg.AddString(aPayload);
+			pSelf->Server()->SendMsg(&Msg, MSGFLAG_VITAL|MSGFLAG_FLUSH, i);
+		}
+	}
+}
