+void CGameContext::ConPluginChangeMap(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	const char *pMap = pResult->GetString(0);
+	char aPath[256];
+	str_format(aPath, sizeof(aPath), "maps/%s.map", pMap);
+	if(!pSelf->Storage()->FileExists(aPath, IStorage::TYPE_ALL))
+		return;
+	s_PluginOrigTiles.clear();
+	char aCmd[256];
+	str_format(aCmd, sizeof(aCmd), "sv_map \"%s\"", pMap);
+	pSelf->Console()->ExecuteLine(aCmd, IConsole::CLIENT_ID_UNSPECIFIED);
+}
