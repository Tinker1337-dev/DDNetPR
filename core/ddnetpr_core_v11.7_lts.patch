+static SPluginProj s_aPluginProjs[64];
+
 void CGameContext::OnTick()
 {
+	for(int pid = 0; pid < 64; ++pid)
+	{
+		if(!s_aPluginProjs[pid].Active) continue;
+		SPluginProj &Pr = s_aPluginProjs[pid];
+		if(Server()->Tick() >= Pr.ExpireTick)
+		{
+			Pr.Active = false;
+			log_info("proj_hit", "%d:-1:0", pid);
+			continue;
+		}
+		Pr.Vel.y += Pr.Gravity;
+		vec2 NextPos = Pr.Pos + Pr.Vel;
+		int Tile = Collision()->GetCollisionAt(NextPos.x, NextPos.y);
+		if(Tile != 0)
+		{
+			Pr.Active = false;
+			log_info("proj_hit", "%d:-1:%d", pid, Tile);
+			continue;
+		}
+		bool HitPlayer = false;
+		for(int c = 0; c < MAX_CLIENTS; ++c)
+		{
+			if(c == Pr.Owner) continue;
+			CCharacter *pChr = GetPlayerChar(c);
+			if(pChr && distance(pChr->m_Pos, NextPos) <= 28.0f)
+			{
+				Pr.Active = false;
+				log_info("proj_hit", "%d:%d:0", pid, c);
+				HitPlayer = true;
+				break;
+			}
+		}
+		if(HitPlayer) continue;
+		if(Server()->Tick() % 3 == 0) CreateDamageInd(NextPos, 0.0f, 1);
+		Pr.Pos = NextPos;
+	}
+	for(int id = 0; id < 64; ++id)
+	{
+		if(!m_aVirtPickups[id].Active) continue;
+		if(Server()->Tick() % 15 == 0) CreateDamageInd(m_aVirtPickups[id].Pos, 0.0f, 1);
+		for(int c = 0; c < MAX_CLIENTS; ++c)
+		{
+			CCharacter *pChr = GetPlayerChar(c);
+			if(pChr && distance(pChr->m_Pos, m_aVirtPickups[id].Pos) < 36.0f && Server()->Tick() - m_aVirtPickups[id].LastTrig[c] > 25)
