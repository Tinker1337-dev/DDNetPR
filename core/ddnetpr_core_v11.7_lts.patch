+void CGameContext::ConRegChatCmd(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	static std::vector<std::tuple<std::string, std::string, std::string>> s_PluginCmds;
+	s_PluginCmds.emplace_back(pResult->GetString(0), pResult->GetString(1), pResult->GetString(2));
+	const char *pName = std::get<0>(s_PluginCmds.back()).c_str();
+	const char *pParams = std::get<1>(s_PluginCmds.back()).c_str();
+	const char *pHelp = std::get<2>(s_PluginCmds.back()).c_str();
+	pSelf->Console()->Register(pName, pParams, CFGFLAG_CHAT, ConPluginChatCmd, pSelf, pHelp);
+	for(int i = 0; i < MAX_CLIENTS; i++)
+	{
+		if(!pSelf->m_apPlayers[i]) continue;
+		if(pSelf->Server()->IsSixup(i))
+		{
+			protocol7::CNetMsg_Sv_CommandInfo Msg;
+			Msg.m_pName = pName; Msg.m_pArgsFormat = pParams; Msg.m_pHelpText = pHelp;
+			pSelf->Server()->SendPackMsg(&Msg, MSGFLAG_VITAL | MSGFLAG_NORECORD, i);
+		}
+		else
+		{
+			CNetMsg_Sv_CommandInfo Msg;
+			Msg.m_pName = pName; Msg.m_pArgsFormat = pParams; Msg.m_pHelpText = pHelp;
+			pSelf->Server()->SendPackMsg(&Msg, MSGFLAG_VITAL | MSGFLAG_NORECORD, i);
+		}
+	}
+}
