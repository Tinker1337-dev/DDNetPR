+void CGameContext::ConRaycast(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	int ReqId = pResult->GetInteger(0);
+	vec2 From(pResult->GetFloat(1), pResult->GetFloat(2));
+	vec2 To(pResult->GetFloat(3), pResult->GetFloat(4));
+	int Mask = pResult->GetInteger(5);
+	float BestDist = length(To - From) + 1.0f;
+	bool HasHit = false;
+	int HitTile = 0;
+	int HitCid = -1;
+	vec2 HitPos = To;
+
+	if((Mask & 1) != 0)
+	{
+		vec2 ColPos, BeforePos;
+		int Tile = pSelf->Collision()->IntersectLine(From, To, &ColPos, &BeforePos);
+		if(Tile != 0)
+		{
+			float d = length(ColPos - From);
+			if(d < BestDist) { BestDist = d; HasHit = true; HitTile = Tile; HitCid = -1; HitPos = ColPos; }
+		}
+	}
+	if((Mask & 2) != 0)
+	{
+		vec2 Dir = To - From;
+		float Len = length(Dir);
+		if(Len > 0.001f)
+		{
+			vec2 Norm = Dir / Len;
+			for(int i = 0; i < MAX_CLIENTS; ++i)
+			{
+				CCharacter *pChr = pSelf->GetPlayerChar(i);
+				if(!pChr) continue;
+				vec2 Rel = pChr->m_Pos - From;
+				float Proj = dot(Rel, Norm);
+				if(Proj < 0.0f || Proj > Len) continue;
+				vec2 Closest = From + Norm * Proj;
+				if(length(pChr->m_Pos - Closest) <= 28.0f && Proj < BestDist)
+				{
+					BestDist = Proj; HasHit = true; HitTile = 0; HitCid = i; HitPos = Closest;
+				}
+			}
+		}
+	}
+	log_info("ray_hit", "%d:%d:%d:%d:%.1f:%.1f:%.1f", ReqId, HasHit ? 1 : 0, HitTile, HitCid, HitPos.x, HitPos.y, HasHit ? BestDist : 0.0f);
+}
