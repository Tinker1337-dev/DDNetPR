+void CGameContext::ConSpawnLaserEx(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	vec2 From(pResult->GetFloat(0), pResult->GetFloat(1));
+	vec2 To(pResult->GetFloat(2), pResult->GetFloat(3));
+	int Type = pResult->GetInteger(4) == 1 ? WEAPON_SHOTGUN : WEAPON_LASER;
+	vec2 Diff = To - From;
+	float Len = length(Diff);
+	vec2 Dir = Len > 0.001f ? Diff / Len : vec2(1.0f, 0.0f);
+	new CLaser(&pSelf->m_World, From, Dir, Len, -1, Type);
+}
+void CGameContext::ConSpawnLaser(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	vec2 From(pResult->GetFloat(0), pResult->GetFloat(1));
+	vec2 To(pResult->GetFloat(2), pResult->GetFloat(3));
+	vec2 Diff = To - From;
+	float Len = length(Diff);
+	vec2 Dir = Len > 0.001f ? Diff / Len : vec2(1.0f, 0.0f);
+	new CLaser(&pSelf->m_World, From, Dir, Len, -1, WEAPON_LASER);
+}
